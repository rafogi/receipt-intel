# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
terraform.tfvars
backend.hcl
.build/
# Keep .terraform.lock.hcl committed so provider versions are reproducible.

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node
node_modules/
dist/
# Local dev settings for the web app (generated from Terraform outputs)
web/public/config.json

# Evaluation data: real receipts contain personal info, keep them out of Git.
eval/data/

# Secrets (API keys for local tools)
.env
.env.*
!.env.example

# Local test output (e.g. aws lambda invoke)
out.json

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
